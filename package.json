{
  "name": "tiny-isprite",
  "version": "2.2.0",
  "type": "module",
  "main": "./dist/Icon.cjs",
  "module": "./dist/Icon.js",
  "types": "./dist/Icon.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/Icon.d.ts",
        "default": "./dist/Icon.js"
      },
      "require": {
        "types": "./dist/Icon.d.cts",
        "default": "./dist/Icon.cjs"
      }
    },
    "./generator": {
      "types": "./core/generate-sprite.d.ts",
      "import": "./core/generate-sprite.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "build-sprite": "./bin/build-sprite.js"
  },
  "files": [
    "dist",
    "bin",
    "core",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/Icon.tsx --format esm,cjs --dts --external react --clean",
    "build:sprite": "node ./bin/build-sprite.js",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "test:browser": "npm run build && node test/browser.mjs",
    "prepack": "npm run build",
    "test:compat": "npm run build && node test/compatibility.mjs",
    "test:production": "node test/production.mjs",
    "check:release": "npm run typecheck && npm test && npm run test:compat && npm run test:browser && npm run test:production && npm audit",
    "dev:demo": "npm run dev --prefix demo",
    "build:demo": "npm run build --prefix demo",
    "test:playground": "npm run build:demo && npm test --prefix demo && node test/playground.mjs && node test/animation-export.mjs && node test/region-origins.mjs && node test/draft-persistence.mjs",
    "test:animation-export": "npm run build:demo && node test/animation-export.mjs"
  },
  "keywords": [
    "svg",
    "svg-sprite",
    "svg-icons",
    "react",
    "react-icons",
    "sprite-generator"
  ],
  "author": "Dina",
  "license": "MIT",
  "description": "SVG sprite generator and React icon component with content-hashed URLs and watch mode.",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.6"
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dynation/tiny-isprite.git"
  },
  "bugs": {
    "url": "https://github.com/Dynation/tiny-isprite/issues"
  },
  "homepage": "https://dynation.github.io/tiny-isprite/"
}
